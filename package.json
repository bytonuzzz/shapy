{
  "name": "@tonuzzz/shapy",
  "version": "0.1.0",
  "description": "Seeded geometric SVG avatars for React, plus an avatar picker. Same text, same avatar, every time.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "avatar",
    "svg",
    "identicon",
    "generative",
    "seeded",
    "deterministic",
    "react",
    "avatar-picker"
  ],
  "author": "tonuzzz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytonuzzz/shapy.git"
  },
  "homepage": "https://github.com/bytonuzzz/shapy",
  "bugs": {
    "url": "https://github.com/bytonuzzz/shapy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
